#!/usr/bin/env bun
/**
 * xthread — Summarize an X (Twitter) thread using twt + pi
 *
 * Uses https://github.com/yashiels/twitter-cli (`twt`) for all X/Twitter access.
 *
 * Usage:
 *   xthread <tweet-id-or-url> [--limit <n>] [--raw] [--out <file>]
 */

import { spawnSync } from "child_process";

// ─── CLI args ────────────────────────────────────────────────────────────────

const args = process.argv.slice(2);

if (args.length === 0 || args.includes("--help") || args.includes("-h")) {
  console.log(`
xthread — Summarize an X thread

Usage:
  xthread <tweet-id-or-url> [options]

Options:
  --limit <n>     Max tweets to fetch from the conversation search (default: 100)
  --raw           Print raw thread text before the summary
  --out <file>    Save the summary to a file
  -h, --help      Show this help

Examples:
  xthread 1234567890123456789
  xthread https://x.com/user/status/1234567890123456789
  xthread 1234567890 --limit 50 --out summary.md
`);
  process.exit(0);
}

let threadIdOrUrl = "";
let showRaw = false;
let outFile = "";
let fetchLimit = 100;

for (let i = 0; i < args.length; i++) {
  if (args[i] === "--limit" && args[i + 1]) {
    const parsed = Number(args[++i]);
    if (!Number.isInteger(parsed) || parsed <= 0) {
      console.error(`❌  --limit must be a positive integer.`);
      process.exit(1);
    }
    fetchLimit = parsed;
  }
  else if (args[i] === "--out" && args[i + 1]) { outFile = args[++i]; }
  else if (args[i] === "--raw")  { showRaw = true; }
  else if (args[i] === "--app" || args[i] === "--twitter-cli") {
    console.error(`❌  ${args[i]} is no longer supported. xthread now uses yashiels/twitter-cli (twt) only.`);
    process.exit(1);
  }
  else if (!args[i].startsWith("--")) { threadIdOrUrl = args[i]; }
}

if (!threadIdOrUrl) {
  console.error("❌  Please provide a tweet ID or URL.");
  process.exit(1);
}

const tweetId = threadIdOrUrl.match(/(\d{10,})/)?.[1] ?? threadIdOrUrl;
if (!/^\d+$/.test(tweetId)) {
  console.error(`❌  Could not extract a valid tweet ID from: ${threadIdOrUrl}`);
  process.exit(1);
}

// ─── Helpers ─────────────────────────────────────────────────────────────────

function color(code: number, text: string) { return `\x1b[${code}m${text}\x1b[0m`; }
const bold   = (s: string) => color(1, s);
const dim    = (s: string) => color(2, s);
const cyan   = (s: string) => color(36, s);
const green  = (s: string) => color(32, s);
const yellow = (s: string) => color(33, s);

function runJson(command: string, commandArgs: string[]): any {
  const r = spawnSync(command, commandArgs, {
    encoding: "utf8",
    maxBuffer: 20 * 1024 * 1024,
  });

  if (r.error) throw new Error(`Could not run ${command}: ${r.error.message}`);
  if (r.status !== 0) {
    const stderr = r.stderr?.trim();
    const stdout = r.stdout?.trim();
    throw new Error(`${command} ${commandArgs.join(" ")} failed` +
      (stderr ? `\n${stderr}` : stdout ? `\n${stdout}` : ""));
  }

  try { return JSON.parse(r.stdout); }
  catch { throw new Error(`Could not parse ${command} JSON response:\n${r.stdout}`); }
}

function twtJson(commandArgs: string[]): any {
  // --quiet keeps status/progress lines on stderr from cluttering wrapper output.
  return runJson("twt", ["--json", "--quiet", ...commandArgs]);
}

function extractHandleFromUrl(input: string): string | undefined {
  return input.match(/(?:x|twitter)\.com\/([^/]+)\/status\/\d+/i)?.[1];
}

function extractUrls(text: string): string[] {
  return [...text.matchAll(/https?:\/\/[^\s)\]}>,"']+/g)]
    .map((m) => m[0].replace(/[.,;:!?]+$/, ""));
}

// ─── Step 1: Fetch thread data via twt ───────────────────────────────────────

interface Tweet {
  id: string;
  text: string;
  created_at: string;
  author_handle: string;
  public_metrics?: { like_count: number; retweet_count: number; reply_count: number; };
  entities?: { urls?: Array<{ url: string; expanded_url: string; display_url: string }> };
}

function normalizeTweet(t: any): Tweet | undefined {
  const id = String(t?.id ?? "");
  const text = String(t?.text ?? "");
  const authorHandle = String(t?.author_handle ?? t?.authorHandle ?? "");
  if (!id || !text) return undefined;

  const urls = extractUrls(text);
  return {
    id,
    text,
    created_at: String(t?.created_at ?? t?.createdAt ?? ""),
    author_handle: authorHandle,
    public_metrics: {
      like_count: Number(t?.favorite_count ?? t?.favoriteCount ?? t?.metrics?.likes ?? 0),
      retweet_count: Number(t?.retweet_count ?? t?.retweetCount ?? t?.metrics?.retweets ?? 0),
      reply_count: Number(t?.reply_count ?? t?.replyCount ?? t?.metrics?.replies ?? 0),
    },
    entities: urls.length > 0
      ? { urls: urls.map((u: string) => ({ url: u, expanded_url: u, display_url: u })) }
      : undefined,
  };
}

function normalizeTweetArray(payload: any): Tweet[] {
  const list = Array.isArray(payload) ? payload : [payload];
  return list.map(normalizeTweet).filter(Boolean) as Tweet[];
}

function dedupeTweets(list: Tweet[]): Tweet[] {
  const seen = new Set<string>();
  const out: Tweet[] = [];
  for (const t of list) {
    if (seen.has(t.id)) continue;
    seen.add(t.id);
    out.push(t);
  }
  return out;
}

console.log(bold("\n🔍  Fetching root tweet via twt…"));

let rootTweet: Tweet | undefined;
try {
  rootTweet = normalizeTweetArray(twtJson(["tweet", tweetId]))[0];
} catch (e: any) {
  console.error(`❌  ${e.message}`);
  console.error("\nInstall/authenticate yashiels/twitter-cli first: brew install yashiels/tap/twt && twt auth login");
  process.exit(1);
}

if (!rootTweet) {
  console.error("❌  Could not retrieve the root tweet. Check the ID and your twt authentication.");
  process.exit(1);
}

const urlHandle = extractHandleFromUrl(threadIdOrUrl);
if (!rootTweet.author_handle && urlHandle) rootTweet.author_handle = urlHandle;

console.log(bold(`🧵  Searching conversation via twt (conversation_id:${tweetId}, limit ${fetchLimit})…`));

let tweets: Tweet[] = [rootTweet];
try {
  // twt/Twitter search can return empty non-JSON output for very small counts,
  // so ask for at least 5 and trim locally to honor --limit.
  const twtSearchLimit = Math.max(fetchLimit, 5);
  const found = normalizeTweetArray(twtJson(["search", `conversation_id:${tweetId}`, "--limit", String(twtSearchLimit)]));
  tweets = dedupeTweets([rootTweet, ...found]).slice(0, fetchLimit);
} catch (e: any) {
  console.warn(yellow(`⚠️  Could not fetch full conversation with twt search: ${e.message}`));
  console.warn(yellow("   Summarising the root tweet only."));
}

// yashiels/twitter-cli currently exposes tweet IDs/handles/counts, but not Twitter's
// v2 conversation_id field. As a result, the provided tweet ID is used as the
// conversation root for search; pass the first tweet in a thread for best results.
tweets.sort((a, b) => {
  const at = new Date(a.created_at).getTime();
  const bt = new Date(b.created_at).getTime();
  return (Number.isFinite(at) ? at : 0) - (Number.isFinite(bt) ? bt : 0);
});
console.log(green(`✅  Retrieved ${tweets.length} tweet(s)`));

// ─── Step 2: Collect external URLs ───────────────────────────────────────────

const seenUrls = new Set<string>();
const allUrls: string[] = [];
for (const t of tweets) {
  for (const u of t.entities?.urls ?? []) {
    const expanded = u.expanded_url ?? u.display_url ?? u.url;
    if (!seenUrls.has(expanded) &&
        !expanded.startsWith("https://x.com/") &&
        !expanded.startsWith("https://twitter.com/")) {
      seenUrls.add(expanded);
      allUrls.push(expanded);
    }
  }
}

// ─── Step 3: Build structured thread text ────────────────────────────────────

const threadAuthorHandle = rootTweet.author_handle || urlHandle || "unknown";

function label(authorHandle: string): string {
  return authorHandle ? `@${authorHandle}` : "[unknown user]";
}

const authorTweets = tweets.filter(t => t.author_handle === threadAuthorHandle || (t.id === rootTweet.id && !t.author_handle));
const replyTweets  = tweets
  .filter(t => !(t.author_handle === threadAuthorHandle || (t.id === rootTweet.id && !t.author_handle)))
  .sort((a, b) => (b.public_metrics?.like_count ?? 0) - (a.public_metrics?.like_count ?? 0));

function renderTweets(list: Tweet[], heading: string): string {
  if (list.length === 0) return `### ${heading}\n(none)`;
  return `### ${heading}\n` + list.map((t, i) => {
    const likes = t.public_metrics?.like_count ?? 0;
    const posted = t.created_at || "unknown date";
    return `[${i + 1}] ${label(t.author_handle)} — ${posted} — ❤️ ${likes}\n${t.text}`;
  }).join("\n\n");
}

const threadText =
  `## THREAD AUTHOR: ${label(threadAuthorHandle)} (${authorTweets.length} post(s))\n\n` +
  renderTweets(authorTweets, "Author's posts") +
  `\n\n## REPLIES FROM OTHERS (${replyTweets.length} post(s), sorted by likes)\n\n` +
  renderTweets(replyTweets, "Replies");

const urlSection = allUrls.length > 0
  ? `\n\n## EXTERNAL LINKS\n` + allUrls.map((u, i) => `[L${i + 1}] ${u}`).join("\n")
  : "";

const fullThreadText = threadText + urlSection;

// ─── Step 4: Print raw thread (optional) ─────────────────────────────────────

if (showRaw) {
  console.log("\n" + bold("─── Raw Thread ─────────────────────────────────"));
  console.log(dim(fullThreadText));
  console.log(bold("────────────────────────────────────────────────\n"));
}

// ─── Step 5: Summarize with pi ────────────────────────────────────────────────

console.log(bold("🤖  Summarizing with pi (gemini-3.1-flash-lite-preview)…\n"));

const systemPrompt =
  "You are an expert at summarizing X (Twitter) threads concisely. " +
  "Respond in clean Markdown. Do not add commentary outside the requested sections.";

const userPrompt =
  `Please summarize the following X thread. The content is split into two sections: ` +
  `the thread author's own posts, and replies from other people. ` +
  `Replies are sorted by like count (most liked first) — prioritize the top-liked replies ` +
  `when choosing representative quotes and summarizing community reactions.\n\n` +
  `Return exactly these sections in Markdown:\n\n` +
  `## TL;DR\n1–3 sentences capturing the core message of the thread.\n\n` +
  `## Author's Perspective\n` +
  `What the thread author is saying, arguing, or sharing. Include 2–3 direct illustrative ` +
  `quotes from their posts (use > blockquote format). Focus on their main ideas and narrative arc.\n\n` +
  `## Community Reactions\n` +
  `What other people are saying in reply — agreement, pushback, questions, additions. ` +
  `Include 2–3 direct illustrative quotes from the most-liked replies ` +
  `(use > blockquote format, and append the ❤️ count after each quote). ` +
  `Highlight the range of reactions if they differ.\n\n` +
  `## Key Takeaways\n3–5 bullet points distilling the most important insights from the whole conversation.\n\n` +
  `## Thread Info\n` +
  `- Author: (main author @handle)\n` +
  `- Author posts: (count)\n` +
  `- Replies from others: (count)\n` +
  `- Posted: (approximate date/time of first tweet)\n\n` +
  `## Links\n` +
  `For each external URL in the thread, list it with a brief description of what it is or what it's about. ` +
  `If there are no external links, write "No external links."\n\n` +
  `---\n\nThread content:\n\n${fullThreadText}`;

const piResult = spawnSync(
  "pi",
  ["--print", "--no-session", "--no-tools", "--model", "gemini-3.1-flash-lite-preview",
   "--system-prompt", systemPrompt, userPrompt],
  { encoding: "utf8", maxBuffer: 10 * 1024 * 1024 }
);

if (piResult.status !== 0) {
  console.error("❌  pi failed:\n" + piResult.stderr);
  process.exit(1);
}

const summary = piResult.stdout.trim();

// ─── Step 6: Output ───────────────────────────────────────────────────────────

const threadUrl = rootTweet.author_handle
  ? `https://x.com/${rootTweet.author_handle}/status/${tweetId}`
  : `https://x.com/i/web/status/${tweetId}`;

const header = `# Thread Summary\n**URL:** ${threadUrl}\n**Generated:** ${new Date().toLocaleString()}\n\n`;
const finalOutput = header + summary;

const glowPath = spawnSync("which", ["glow"], { encoding: "utf8" }).stdout.trim();
if (glowPath) {
  const tmp = `/tmp/xthread-${Date.now()}.md`;
  await Bun.write(tmp, finalOutput);
  spawnSync("glow", [tmp], { stdio: "inherit" });
  spawnSync("rm", [tmp]);
} else {
  console.log("\n" + cyan(bold("═══════════════════════════════════════════════════")));
  console.log(finalOutput);
  console.log(cyan(bold("═══════════════════════════════════════════════════")) + "\n");
}

if (outFile) {
  await Bun.write(outFile, finalOutput);
  console.log(green(`💾  Summary saved to: ${outFile}`));
}
